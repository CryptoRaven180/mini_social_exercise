{% extends "base.html.j2" %}
{% block content %}
<div class="container col-md-5 mx-auto mt-5">
  {% if suspension %}
  <div class="alert alert-danger border-danger shadow-sm p-3 mb-3">
    <h5 class="alert-heading">⚠️ Account sospended</h5>
    <p class="mb-0">You received your final strike and have been suspended for 30 days from {{ suspension.since|datetimeformat }} 
      </p>
  </div>
  {% endif %}
  <div class="card p-4">
    <h2 class="mb-4 text-center">Login</h2>
    <form method="POST">
      <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <input type="text" class="form-control" id="username" name="username" required>
      </div>
      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input type="password" class="form-control" id="password" name="password" required>
      </div>
      <div class="d-grid">
        <button type="submit" class="btn btn-primary">Login</button>
      </div>
    </form>
    <div class="text-center mt-3">
      <small class="text-muted">
        Don't have an account yet? <a href="/signup">Sign Up</a>
      </small>
    </div>
  </div>
</div>
{% endblock %}