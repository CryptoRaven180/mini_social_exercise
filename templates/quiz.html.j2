{% extends "base.html.j2" %}
{% block content %}
<div class="container col-md-8 mx-auto mt-5">
  <div class="card p-4">
    <h2 class="mb-4 text-center">📜 Community Quiz</h2>
    <p class="text-muted text-center">
      Answer the questions below to finish setting up your account. Every
      round is a random draw from the community rules. If you make a
      mistake, you will see an explanation and get a new set of questions.
    </p>

    {% if wrong %}
    <div class="alert alert-warning">
      <h5 class="alert-heading">Some answers were not correct — read the explanations and try again!</h5>
      <ul class="mb-0">
        {% for q in wrong %}
        <li><strong>{{ q.question_text }}</strong><br>
          {% if q.user_answer %}Your answer: <em>{{ q.user_answer }}</em> — {% else %}No answer given — {% endif %}
          <span class="text-danger">The right answer is: {{ q.options[q.correct_option] }}</span><br>
          <small>{{ q.explanation }}</small></li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    <form method="POST">
      {% for q in questions %}
      <div class="card mb-3">
        <div class="card-body">
          <h6 class="card-title">{{ loop.index }}. {{ q.question_text }}</h6>
          {% for option in q.options %}
          <div class="form-check">
            <input class="form-check-input" type="radio"
                   id="opt-{{ q.id }}-{{ loop.index0 }}"
                   name="answer_{{ q.id }}" value="{{ loop.index0 }}" required>
            <label class="form-check-label" for="opt-{{ q.id }}-{{ loop.index0 }}">
              {{ option }}
            </label>
          </div>
          {% endfor %}
        </div>
      </div>
      {% endfor %}
      <div class="d-grid">
        <button type="submit" class="btn btn-primary">Submit answers</button>
      </div>
    </form>
  </div>
</div>
{% endblock %}